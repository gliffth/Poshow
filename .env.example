# ═══════════════════════════════════════════════════════════════
# POSHOW — environment variables (set them in the dashboards; never commit real values)
# ═══════════════════════════════════════════════════════════════

# ── Render (API) ─────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=service_role key (Supabase → Project Settings → API). SECRET — Render only.
AUTH_SECRET=long random string (render.yaml generates one for you)
BOT_USERNAME=YourBotUsername            # no @
ALLOWED_ORIGINS=https://poshow.vercel.app   # optional

# ── Vercel (website) ─────────────────────────────────────────
# Baked in at BUILD time — after changing it, redeploy.
NEXT_PUBLIC_API_URL=https://poshow.onrender.com

# ── Telegram bot host (anywhere that runs python telegram-bot/bot.py) ──
BOT_TOKEN=from @BotFather
SUPABASE_URL=same as above
SUPABASE_KEY=same as above
