# Environment variables. Set them in the hosting dashboards; do not commit real values.
# See docs/DEPLOY.md for what each one does.

# API (Render)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=service_role key (Supabase > Project Settings > API); keep it secret
AUTH_SECRET=long random string (render.yaml generates one)
BOT_TOKEN=from @BotFather (verifies Mini App sign-in, sends notifications)
BOT_USERNAME=YourBotUsername                # without @
ALLOWED_ORIGINS=https://poshow.vercel.app   # optional
ADMIN_USERNAMES=YourWebUsername             # comma-separated; these accounts get the Admin panel
ADMIN_USER_IDS=123456789                    # comma-separated user ids

# Web app (Vercel); read at build time, redeploy after changing
NEXT_PUBLIC_API_URL=https://poshow.onrender.com

# Telegram bot host
# BOT_TOKEN, SUPABASE_URL, SUPABASE_KEY and ADMIN_USER_IDS as above
# KEEPALIVE_URL=https://poshow.onrender.com   # optional: ping the API so a free-tier instance does not sleep
# KEEPALIVE_INTERVAL=600                      # seconds, 60-840
